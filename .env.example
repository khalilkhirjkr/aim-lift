# Copy to .env for local use, or set these as environment variables on the host.
# .env is git-ignored and must never be committed.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
DJANGO_BEHIND_PROXY=True

# --- Database (Supabase Postgres, session pooler / port 5432) ---
# Project settings -> Database -> Connection string -> "Session pooler"
DATABASE_URL=postgresql://postgres.oealsslggqnszmpjcizn:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- CORS: origins of the deployed frontend(s), comma-separated ---
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- IoT sensor ingest (POST /api/iot/reading/) ---
# The ESP32 must send this exact value in the "X-Device-Key" header.
IOT_DEVICE_KEY=change-me-to-a-long-random-string
SENSOR_READINGS_KEEP=200          # rolling window of readings kept per lift
PREDICT_ALERT_CONFIDENCE=80       # min model confidence (%) to open a predicted-failure incident

# --- Optional: store uploaded media in Supabase Storage (S3-compatible) ---
# Project settings -> Storage -> S3 Connection
USE_SUPABASE_STORAGE=False
SUPABASE_S3_ENDPOINT_URL=https://oealsslggqnszmpjcizn.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
